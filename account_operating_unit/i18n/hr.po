msgstr "Tvrtke"

#. module: account_operating_unit
#. odoo-python
#: code:addons/account_operating_unit/models/account_journal.py:0
msgid ""
"Configuration error. If defined as self-balanced at company level, the "
"operating unit is mandatory in bank journal."
msgstr ""
"Pogreška konfiguracije. Ako je definirano kao samouravnoteženo na razini "
"tvrtke, organizacijska jedinica je obavezna u bankovnom dnevniku."

#. module: account_operating_unit
#. odoo-python
#: code:addons/account_operating_unit/models/res_company.py:0
msgid ""
"Configuration error. Please provide an Inter-operating unit clearing "
"account."
msgstr ""
"Pogreška konfiguracije. Navedite konto poravnanja između organizacijskih "
"jedinica."

#. module: account_operating_unit
#. odoo-python
#: code:addons/account_operating_unit/models/account_move.py:0
msgid ""
"Configuration error. The Operating Unit in the Move Line and in the Move "
"must be the same."
msgstr ""
"Pogreška konfiguracije. Organizacijska jedinica u stavci knjiženja i u "
"knjiženju moraju biti iste."

#. module: account_operating_unit
#. odoo-python
#: code:addons/account_operating_unit/models/account_move.py:0
msgid ""
"Configuration error. The operating unit is mandatory for each line as the "
"operating unit has been defined as self-balanced at company level."
msgstr ""
"Pogreška konfiguracije. Organizacijska jedinica je obavezna za svaku stavku "
"jer je organizacijska jedinica definirana kao samouravnotežena na razini "
"tvrtke."

#. module: account_operating_unit
#. odoo-python
#: code:addons/account_operating_unit/models/account_move.py:0
msgid ""
"Configuration error. You need to define aninter-operating unit clearing "
"account in the company settings"
msgstr ""
"Pogreška konfiguracije. Morate definirati konto poravnanja između "
"organizacijskih jedinica u postavkama tvrtke"

