#. module: base_multicompany_reporting_currency
#: model_terms:ir.ui.view,arch_db:base_multicompany_reporting_currency.res_config_settings_view_form
msgid ""
"Changing the multicompany reporting currency may affect lots of records,\n"
"                            and trigger heavy recomputations. Please do not change this value unless\n"
"                            it is absolutely necessary."
msgstr ""
"Promjena viševalutne izvještajne valute može utjecati na mnogo zapisa\n"
"                            i pokrenuti velike ponovne izračune. Ne mijenjajte ovu vrijednost osim ako\n"
"                            nije apsolutno potrebno."

