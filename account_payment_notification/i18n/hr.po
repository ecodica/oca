#. module: account_payment_notification
#: model:mail.template,body_html:account_payment_notification.mail_template_notification
msgid ""
"<p>Dear <t t-out=\"object.partner_id.name or ''\">Azure Interior</t>,</p>\n"
"            <p t-if=\"object.payment_type == 'inbound'\">\n"
"                Your debit order was processed and sent to the bank.\n"
"            </p>\n"
"            <p t-else=\"\">\n"
"                Your payment order was processed and sent to the bank.\n"
"            </p>\n"
"            <p t-if=\"object.reconciled_invoices_type == 'invoice'\">\n"
"                It includes the following invoices:\n"
"            </p>\n"
"            <p t-else=\"\">\n"
"                It includes the following credit notes:\n"
"            </p>\n"
"            <ul>\n"
"                <t t-foreach=\"object.reconciled_invoice_ids\" t-as=\"invoice\">\n"
"                    <li t-out=\"invoice.name\">INV/2022/00001</li>\n"
"                </t>\n"
"                <t t-foreach=\"object.reconciled_bill_ids\" t-as=\"bill\">\n"
"                    <li t-out=\"bill.ref or bill.name\">INV/2022/00002</li>\n"
"                </t>\n"
"            </ul>\n"
"            <p>Total amount: <strong t-field=\"object.amount\"/></p>\n"
"            <div data-o-mail-quote-container=\"1\">\n"
"                <p>Thanks for your cooperation!</p>\n"
"                <p data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.company_id.name\" data-o-mail-quote=\"1\"/></p>\n"
"                <p data-o-mail-quote=\"1\">\n"
"                    <small data-o-mail-quote=\"1\">This is an automated notification. Replies will not be monitored nor answered. If you have questions, please contact us by the usual means.</small>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<p>Poštovani <t t-out=\"object.partner_id.name or ''\">Azure Interior</t>,</p>\n"
"            <p t-if=\"object.payment_type == 'inbound'\">\n"
"                Vaš nalog za terećenje obrađen je i poslan banci.\n"
"            </p>\n"
"            <p t-else=\"\">\n"
"                Vaš nalog za plaćanje obrađen je i poslan banci.\n"
"            </p>\n"
"            <p t-if=\"object.reconciled_invoices_type == 'invoice'\">\n"
"                Uključuje sljedeće račune:\n"
"            </p>\n"
"            <p t-else=\"\">\n"
"                Uključuje sljedeća odobrenja:\n"
"            </p>\n"
"            <ul>\n"
"                <t t-foreach=\"object.reconciled_invoice_ids\" t-as=\"invoice\">\n"
"                    <li t-out=\"invoice.name\">INV/2022/00001</li>\n"
"                </t>\n"
"                <t t-foreach=\"object.reconciled_bill_ids\" t-as=\"bill\">\n"
"                    <li t-out=\"bill.ref or bill.name\">INV/2022/00002</li>\n"
"                </t>\n"
"            </ul>\n"
"            <p>Ukupni iznos: <strong t-field=\"object.amount\"/></p>\n"
"            <div data-o-mail-quote-container=\"1\">\n"
"                <p>Hvala na suradnji!</p>\n"
"                <p data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.company_id.name\" data-o-mail-quote=\"1\"/></p>\n"
"                <p data-o-mail-quote=\"1\">\n"
"                    <small data-o-mail-quote=\"1\">Ovo je automatizirana obavijest. Odgovori se ne prate niti se na njih odgovara. Ako imate pitanja, kontaktirajte nas na uobičajen način.</small>\n"
"                </p>\n"
"            </div>\n"
"        "

