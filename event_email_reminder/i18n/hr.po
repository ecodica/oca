#. module: event_email_reminder
#: model:mail.template,body_html:event_email_reminder.event_email_reminder_template
msgid ""
"<p>Hello <t t-out=\"object.name\"/>,</p>\n"
"            <p>This is a event's summary: </p>\n"
"            <table>\n"
"                <thead>\n"
"                    <tr style=\"height: 15px; background-color: #d8d8d8;font-size: 13px;font-weight:bold;\" align=\"center\" valign=\"middle\">\n"
"                        <td>Date Begin</td>\n"
"                        <td>Event Name</td>\n"
"                        <td>Date End</td>\n"
"                        <td>State</td>\n"
"                    </tr>\n"
"                </thead>\n"
"                <tr t-foreach=\"ctx.get('events', [])\" t-as=\"event\">\n"
"                    <td>\n"
"                        <span t-out=\"event.date_begin\" t-options=\"{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'short'}\"/>\n"
"                    </td>\n"
"                    <td>\n"
"                        <span t-out=\"event.name\"/>\n"
"                    </td>\n"
"                    <td>\n"
"                        <span t-out=\"event.date_end\" t-options=\"{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'short'}\"/>\n"
"                    </td>\n"
"                    <td>\n"
"                        <span t-out=\"event.stage_id.name\" style=\"font-weight:bold;\"/>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        "
