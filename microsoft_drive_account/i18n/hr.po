#. module: microsoft_drive_account
#: model_terms:ir.ui.view,arch_db:microsoft_drive_account.res_users_simple_form_view
msgid ""
"<span invisible=\"microsoft_drive_status == 'connected'\">\n"
"                            You are not connected to Drive. Click the button below to\n"
"                            connect.\n"
"                        </span>\n"
"                        <span invisible=\"microsoft_drive_status == 'not_connected'\">\n"
"                            You are connected to Drive. Click the button below to\n"
"                            disconnect or reset your account.\n"
"                        </span>"
msgstr ""
"<span invisible=\"microsoft_drive_status == 'connected'\">\n"
"                            Niste povezani s Driveom. Kliknite gumb u nastavku za\n"
"                            povezivanje.\n"
"                        </span>\n"
"                        <span invisible=\"microsoft_drive_status == 'not_connected'\">\n"
"                            Povezani ste s Driveom. Kliknite gumb u nastavku za\n"
"                            prekid veze ili resetiranje računa.\n"
"                        </span>"

