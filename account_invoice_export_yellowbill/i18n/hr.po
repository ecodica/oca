#. module: account_invoice_export_yellowbill
#. odoo-python
#: code:addons/account_invoice_export_yellowbill/models/account_invoice_yellowbill.py:0
msgid ""
"%(name)s has no recipient bank account, so the eBill cannot tell the "
"customer how to pay it."
msgstr ""
"%(name)s nema primateljev bankovni račun, pa eRačun ne može reći kupcu kako "
"ga platiti."

#. module: account_invoice_export_yellowbill
#. odoo-python
#: code:addons/account_invoice_export_yellowbill/models/account_invoice_yellowbill.py:0
msgid ""
"%(name)s is not a customer invoice or credit note, it cannot be exported as "
"an eBill."
msgstr ""
"%(name)s nije račun kupca ni odobrenje, ne može se izvesti kao eRačun."

