#. module: account_invoice_constraint_chronology
#. odoo-python
#: code:addons/account_invoice_constraint_chronology/model/account_move.py:0
msgid ""
"Chronology conflict: A conflicting draft invoice dated before %s exists, "
"please validate it first."
msgstr ""
"Sukob kronologije: postoji sukobljeni nacrt računa s datumom prije %s, "
"najprije ga validirajte."

#. module: account_invoice_constraint_chronology
#. odoo-python
#: code:addons/account_invoice_constraint_chronology/model/account_move.py:0
msgid ""
"Chronology conflict: A conflicting validated invoice dated after %s exists."
msgstr ""
"Sukob kronologije: postoji sukobljeni validirani račun s datumom nakon %s."

#. module: account_invoice_constraint_chronology
#. odoo-python
#: code:addons/account_invoice_constraint_chronology/model/account_move.py:0
msgid ""
"Chronology conflict: An invoice with a higher number %(highest_name)s dated "
"before %(date_invoice)s exists."
msgstr ""
"Sukob kronologije: postoji račun s višim brojem %(highest_name)s s datumom "
"prije %(date_invoice)s."

#. module: account_invoice_constraint_chronology
#. odoo-python
#: code:addons/account_invoice_constraint_chronology/model/account_move.py:0
msgid ""
"Chronology conflict: Invoice %(name)s cannot be %(time)s invoice "
"%(inv_name)s."
msgstr ""
"Sukob kronologije: račun %(name)s ne može biti %(time)s računa %(inv_name)s."

