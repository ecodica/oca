#. module: account_payment_batch_oca
#: model:mail.template,body_html:account_payment_batch_oca.payment_order_mail_notif
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <h2 style=\"text-align: center;\">\n"
"            <t t-if=\"object.payment_type == 'inbound'\">Debit</t><t t-if=\"object.payment_type == 'outbound'\">Payment</t> notification\n"
"        </h2>\n"
"\n"
"                <p><t t-out=\"object.company_id.name\">My Company</t> has sent instructions to its bank to execute a <t t-if=\"object.payment_type == 'inbound'\">debit order</t><t t-if=\"object.payment_type == 'outbound'\">payment order</t> which includes the <t t-if=\"object.payment_type == 'inbound'\">debit(s)</t><t t-if=\"object.payment_type == 'outbound'\">payment(s)</t> below for <strong>\n"
"                    <t t-out=\"ctx.get('partner_display_name')\">Azur Interior</t>\n"
"                </strong>.</p>\n"
"                <table style=\"border-spacing: 0; border-collapse: collapse; width: 100%; text-align: center;\">\n"
"                    <tr>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\">\n"
"                            <t t-if=\"object.payment_type == 'inbound'\">Debit Date</t>\n"
"                            <t t-if=\"object.payment_type == 'outbound'\">Payment Date</t>\n"
"                        </th>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\">Label</th>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\">Amount</th>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\" t-if=\"ctx.get('detail_col')\">Details</th>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\">\n"
"                            <t t-if=\"object.payment_type == 'inbound'\">Debited Bank Account</t>\n"
"                            <t t-if=\"object.payment_type == 'outbound'\">Destination Bank Account</t>\n"
"                        </th>\n"
"                    </tr>\n"
"                    <t t-foreach=\"ctx.get('payments')\" t-as=\"payment\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 5px; border: 2px solid black; text-align: center;\">\n"
"                                <t t-out=\"payment['date']\">02/07/2025</t>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 2px solid black; text-align: left;\">\n"
"                                <t t-out=\"payment['payment_ref']\">F250012-F250042</t>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 2px solid black; text-align: right;\">\n"
"                                <t t-out=\"payment['amount']\">2 546,56 €</t>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 2px solid black;\" t-if=\"ctx.get('detail_col')\">\n"
"                                <table t-if=\"payment['lines']\" style=\"border-spacing: 0; border-collapse: collapse; width: 100%;\">\n"
"                                    <t t-foreach=\"payment['lines']\" t-as=\"line\">\n"
"                                        <tr>\n"
"                                            <td style=\"padding: 2px; border: 1px solid grey; text-align: left;\">\n"
"                                                <t t-out=\"line['communication']\">F250012</t>\n"
"                                            </td>\n"
"                                            <td style=\"padding: 2px; border: 1px solid grey; text-align: right;\">\n"
"                                                <t t-out=\"line['amount']\">1 400,36 €</t>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </t>\n"
"                                </table>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 2px solid black;\">\n"
"                                <t t-out=\"payment['bank_account_number_scrambled']\">FR66 **** **** **** **** ***2 121</t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </t>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <h2 style=\"text-align: center;\">\n"
"            <t t-if=\"object.payment_type == 'inbound'\">Obavijest o terećenju</t><t t-if=\"object.payment_type == 'outbound'\">Obavijest o plaćanju</t>\n"
"        </h2>\n"
"\n"
"                <p><t t-out=\"object.company_id.name\">Moja tvrtka</t> je poslao upute svojoj banci za izvršenje <t t-if=\"object.payment_type == 'inbound'\">naloga za terećenje</t><t t-if=\"object.payment_type == 'outbound'\">naloga za plaćanje</t> koji uključuje <t t-if=\"object.payment_type == 'inbound'\">terećenje(a)</t><t t-if=\"object.payment_type == 'outbound'\">plaćanje(a)</t> u nastavku za <strong>\n"
"                    <t t-out=\"ctx.get('partner_display_name')\">Azur Interior</t>\n"
"                </strong>.</p>\n"
"                <table style=\"border-spacing: 0; border-collapse: collapse; width: 100%; text-align: center;\">\n"
"                    <tr>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\">\n"
"                            <t t-if=\"object.payment_type == 'inbound'\">Datum terećenja</t>\n"
"                            <t t-if=\"object.payment_type == 'outbound'\">Datum plaćanja</t>\n"
"                        </th>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\">Oznaka</th>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\">Iznos</th>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\" t-if=\"ctx.get('detail_col')\">Detalji</th>\n"
"                        <th style=\"padding: 5px; border: 2px solid black;\">\n"
"                            <t t-if=\"object.payment_type == 'inbound'\">Terećeni bankovni račun</t>\n"
"                            <t t-if=\"object.payment_type == 'outbound'\">Odredišni bankovni račun</t>\n"
"                        </th>\n"
"                    </tr>\n"
"                    <t t-foreach=\"ctx.get('payments')\" t-as=\"payment\">\n"
"                        <tr>\n"
"                            <td style=\"padding: 5px; border: 2px solid black;\">\n"
"                                <t t-out=\"payment['date']\" t-options=\"{'widget': 'date'}\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 2px solid black;\">\n"
"                                <t t-out=\"payment['label']\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 2px solid black;\">\n"
"                                <t t-out=\"payment['amount']\"/>\n"
"                            </td>\n"
"                            <t t-if=\"ctx.get('detail_col')\">\n"
"                                <td style=\"padding: 5px; border: 2px solid black;\">\n"
"                                    <t t-out=\"payment.get('details', '')\"/>\n"
"                                </td>\n"
"                            </t>\n"
"                            <td style=\"padding: 5px; border: 2px solid black;\">\n"
"                                <t t-out=\"payment['bank_account']\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </t>\n"
"                </table>\n"
"            </div>"

